DATABASE_URL=postgresql://...
BETTER_AUTH_SECRET=generate-with-openssl-rand
# Public origin of the app. The MCP resource identifier is derived from it
# (${BETTER_AUTH_URL}/mcp) and is baked into issued access tokens, so it must
# match the URL clients actually connect to.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# GitHub App (optional, for repo sync)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=   # PKCS#8 PEM: openssl pkcs8 -topk8 -nocrypt -in app.pem
GITHUB_APP_WEBHOOK_SECRET=
